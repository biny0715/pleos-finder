<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape><solid android:color="@color/pleos_segment_selected" /><corners android:radius="@dimen/pleos_segment_item_radius" /></shape>
    </item>
    <item>
        <shape><solid android:color="@android:color/transparent" /><corners android:radius="@dimen/pleos_segment_item_radius" /></shape>
    </item>
</selector>
