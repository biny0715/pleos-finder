<?xml version="1.0" encoding="utf-8"?>
<!-- Basic button: alpha_dark_50(5%), pressed 10% -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@android:color/transparent" />
            <stroke android:width="2dp" android:color="@color/pleos_button_disabled" />
            <corners android:radius="@dimen/pleos_button_radius_medium" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/pleos_button_basic_pressed" /><corners android:radius="@dimen/pleos_button_radius_medium" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/pleos_button_basic_enabled" /><corners android:radius="@dimen/pleos_button_radius_medium" /></shape>
    </item>
</selector>
