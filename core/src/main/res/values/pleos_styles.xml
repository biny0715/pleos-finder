<?xml version="1.0" encoding="utf-8"?>
<!-- Pleos 디자인 시스템을 옮긴 공용 스타일. 크기는 pleos_dimens 를 따른다. -->
<resources>

    <!-- Typography -->
    <style name="TextAppearance.Pleos.Headline" parent="">
        <item name="android:textSize">@dimen/pleos_text_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/pleos_text_primary</item>
    </style>

    <style name="TextAppearance.Pleos.Title" parent="">
        <item name="android:textSize">@dimen/pleos_text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/pleos_text_primary</item>
    </style>

    <style name="TextAppearance.Pleos.TitleSmall" parent="">
        <item name="android:textSize">@dimen/pleos_text_title_small</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/pleos_text_primary</item>
    </style>

    <style name="TextAppearance.Pleos.Body" parent="">
        <item name="android:textSize">@dimen/pleos_text_body</item>
        <item name="android:textColor">@color/pleos_text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="TextAppearance.Pleos.BodySmall" parent="">
        <item name="android:textSize">@dimen/pleos_text_body_small</item>
        <item name="android:textColor">@color/pleos_text_tertiary</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="TextAppearance.Pleos.Label" parent="">
        <item name="android:textSize">@dimen/pleos_text_label</item>
        <item name="android:textColor">@color/pleos_text_tertiary</item>
    </style>

    <!-- Basic button: 공통 -->
    <style name="Widget.Pleos.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@null</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">@dimen/pleos_button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/pleos_button_padding_horizontal</item>
        <item name="android:textSize">@dimen/pleos_button_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:stateListAnimator">@animator/pleos_press_scale</item>
    </style>

    <!-- Basic button Large / filled(basic_600): 화면의 주요 동작 -->
    <style name="Widget.Pleos.Button.Filled">
        <item name="android:minHeight">@dimen/pleos_button_height_large</item>
        <item name="android:background">@drawable/pleos_bg_button_filled</item>
        <item name="android:textColor">@color/pleos_button_text_filled</item>
    </style>

    <!-- Basic button Medium / alpha 5%: 보조 동작 -->
    <style name="Widget.Pleos.Button.Basic">
        <item name="android:minHeight">@dimen/pleos_button_height_medium</item>
        <item name="android:background">@drawable/pleos_bg_button_basic</item>
        <item name="android:textColor">@color/pleos_button_text_basic</item>
    </style>

    <!-- 대화상자 버튼: 주요·보조 버튼을 같은 높이(Medium)로 나란히 두고 사이를 띄운다. -->
    <style name="Widget.Pleos.Button.Filled.Dialog">
        <item name="android:minHeight">@dimen/pleos_button_height_medium</item>
        <item name="android:minWidth">@dimen/pleos_dialog_button_min_width</item>
        <item name="android:layout_marginStart">@dimen/pleos_dialog_button_gap</item>
    </style>

    <style name="Widget.Pleos.Button.Basic.Dialog">
        <item name="android:minWidth">@dimen/pleos_dialog_button_min_width</item>
    </style>

    <!-- Segmented menu 항목 (RadioButton) -->
    <style name="Widget.Pleos.Segment" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/pleos_bg_segment_item</item>
        <item name="android:textColor">@color/pleos_segment_text</item>
        <item name="android:textSize">@dimen/pleos_text_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Toast: 패널 하단 가운데, #131417 84%, 흰 글자 -->
    <style name="Widget.Pleos.Toast" parent="">
        <item name="android:background">@drawable/pleos_bg_toast</item>
        <item name="android:textColor">@color/pleos_toast_text</item>
        <item name="android:textSize">@dimen/pleos_text_body_small</item>
        <item name="android:paddingStart">@dimen/pleos_toast_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/pleos_toast_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/pleos_toast_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/pleos_toast_padding_vertical</item>
        <item name="android:maxWidth">@dimen/pleos_toast_max_width</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Widget.Pleos.Card" parent="">
        <item name="android:background">@drawable/pleos_bg_card</item>
        <item name="android:padding">@dimen/pleos_card_padding</item>
        <item name="android:orientation">vertical</item>
    </style>
</resources>
