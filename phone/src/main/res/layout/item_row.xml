<?xml version="1.0" encoding="utf-8"?>
<!-- 폰 목록 한 줄: 그룹 또는 구성원. 버튼(actions)은 아래에 붙는다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/pleos_bg_row"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/avatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/pleos_bg_avatar"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Pleos.Label"
            android:textColor="@color/pleos_text_primary"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Pleos.TitleSmall" />

                <ImageView
                    android:id="@+id/personIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="Finder 폰 앱 사용"
                    android:src="@drawable/pleos_ic_person" />

                <ImageView
                    android:id="@+id/carIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="2dp"
                    android:contentDescription="Pleos 차량 운전"
                    android:src="@drawable/pleos_ic_car" />

                <ImageView
                    android:id="@+id/favoriteIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="즐겨찾기"
                    android:src="@drawable/pleos_ic_star"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/pleos_dot" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Pleos.BodySmall" />
            </LinearLayout>
        </LinearLayout>

        <!-- 고른 줄의 오른쪽 즐겨찾기 별 -->
        <ImageButton
            android:id="@+id/favoriteButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/pleos_bg_button_basic"
            android:padding="@dimen/pleos_icon_button_padding"
            android:scaleType="fitCenter"
            android:stateListAnimator="@animator/pleos_press_scale"
            android:visibility="gone" />

        <TextView
            android:id="@+id/chevron"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textAppearance="@style/TextAppearance.Pleos.Title"
            android:textColor="@color/pleos_text_quaternary"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:visibility="gone" />
</LinearLayout>
