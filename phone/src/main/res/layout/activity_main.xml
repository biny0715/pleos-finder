<?xml version="1.0" encoding="utf-8"?>
<!-- 폰 앱: Pleos 디자인 토큰(폰 크기로 줄인 dimens)과 Asta Sans 를 쓴다. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pleos_background_primary"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_title"
                    android:textAppearance="@style/TextAppearance.Pleos.Title" />

                <TextView
                    android:id="@+id/accountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Pleos.Label" />
            </LinearLayout>

            <!-- 지금 내 위치를 보내고 있는지 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/shareDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/pleos_dot" />

                <TextView
                    android:id="@+id/shareText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Pleos.BodySmall" />
            </LinearLayout>

            <!-- 지도: 나에게 공유된 사람·차량, 픽업 중이면 차와 나를 잇는 선 -->
            <FrameLayout
                android:id="@+id/mapCard"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginBottom="@dimen/pleos_gap"
                android:background="@drawable/pleos_bg_card"
                android:clipToOutline="true">

                <org.maplibre.android.maps.MapView
                    android:id="@+id/mapView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <!-- 가족 그룹 초대 -->
            <LinearLayout
                android:id="@+id/inviteCard"
                style="@style/Widget.Pleos.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/pleos_gap"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_invite"
                    android:textAppearance="@style/TextAppearance.Pleos.Label" />

                <TextView
                    android:id="@+id/inviteTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="@style/TextAppearance.Pleos.TitleSmall" />

                <TextView
                    android:id="@+id/inviteDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:textAppearance="@style/TextAppearance.Pleos.BodySmall" />

                <Button
                    android:id="@+id/inviteAlwaysButton"
                    style="@style/Widget.Pleos.Button.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_accept_always" />

                <Button
                    android:id="@+id/inviteTemporaryButton"
                    style="@style/Widget.Pleos.Button.Basic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/action_accept_temporary" />

                <Button
                    android:id="@+id/inviteDeclineButton"
                    style="@style/Widget.Pleos.Button.Basic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/action_decline_invite" />
            </LinearLayout>

            <!-- 위치 공유 요청 (일시적 허용) -->
            <LinearLayout
                android:id="@+id/requestCard"
                style="@style/Widget.Pleos.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/pleos_gap"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_request"
                    android:textAppearance="@style/TextAppearance.Pleos.Label" />

                <TextView
                    android:id="@+id/requestTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="@style/TextAppearance.Pleos.TitleSmall" />

                <TextView
                    android:id="@+id/requestDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:textAppearance="@style/TextAppearance.Pleos.BodySmall" />

                <Button
                    android:id="@+id/acceptRequestButton"
                    style="@style/Widget.Pleos.Button.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_accept_request" />

                <Button
                    android:id="@+id/declineRequestButton"
                    style="@style/Widget.Pleos.Button.Basic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/action_decline_request" />
            </LinearLayout>

            <!-- 픽업: 누군가 픽업하러 올 때만 -->
            <LinearLayout
                android:id="@+id/pickupCard"
                style="@style/Widget.Pleos.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/pleos_gap"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_pickup"
                    android:textAppearance="@style/TextAppearance.Pleos.Label" />

                <TextView
                    android:id="@+id/pickupHeadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="@style/TextAppearance.Pleos.Headline" />

                <TextView
                    android:id="@+id/pickupDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Pleos.BodySmall" />

                <LinearLayout
                    android:id="@+id/pickupMetrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/remainDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Pleos.Title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_remain_distance"
                            android:textAppearance="@style/TextAppearance.Pleos.Label" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/remainTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Pleos.Title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_remain_time"
                            android:textAppearance="@style/TextAppearance.Pleos.Label" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 가족 · 친구 · 그룹: 각 패널은 제목 줄 + 카드 -->
            <include
                android:id="@+id/familyHeader"
                layout="@layout/item_section_header" />

            <LinearLayout
                android:id="@+id/familyList"
                style="@style/Widget.Pleos.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <include
                android:id="@+id/friendHeader"
                layout="@layout/item_section_header" />

            <LinearLayout
                android:id="@+id/friendList"
                style="@style/Widget.Pleos.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <include
                android:id="@+id/groupHeader"
                layout="@layout/item_section_header" />

            <LinearLayout
                android:id="@+id/groupList"
                style="@style/Widget.Pleos.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
