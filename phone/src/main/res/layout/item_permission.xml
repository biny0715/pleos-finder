<?xml version="1.0" encoding="utf-8"?>
<!-- 상대 한 명에게 내 위치를 보여 주는 방식 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/permissionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Pleos.Label" />

    <RadioGroup
        android:id="@+id/permissionGroup"
        android:layout_width="match_parent"
        android:layout_height="@dimen/pleos_segment_height"
        android:layout_marginTop="8dp"
        android:background="@drawable/pleos_bg_segment_container"
        android:orientation="horizontal"
        android:padding="@dimen/pleos_segment_inset">

        <RadioButton
            android:id="@+id/permissionAlways"
            style="@style/Widget.Pleos.Segment"
            android:text="@string/permission_always" />

        <RadioButton
            android:id="@+id/permissionTemporary"
            style="@style/Widget.Pleos.Segment"
            android:text="@string/permission_temporary" />

        <RadioButton
            android:id="@+id/permissionOff"
            style="@style/Widget.Pleos.Segment"
            android:text="@string/permission_off" />
    </RadioGroup>

    <TextView
        android:id="@+id/permissionDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAppearance="@style/TextAppearance.Pleos.BodySmall" />
</LinearLayout>
