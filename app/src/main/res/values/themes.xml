<resources>
    <!--
      Pleos 차량 앱 테마. 액션바 없이 앱이 직접 머리글을 그린다.
      색은 core 의 pleos 토큰(주간/야간)을, 글꼴은 차량 시스템 글꼴(Asta Sans)을 그대로 쓴다.
    -->
    <style name="Theme.PleosFinder" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pleos_basic_600</item>
        <item name="colorPrimaryVariant">@color/pleos_basic_700</item>
        <item name="colorOnPrimary">@color/pleos_text_on_filled</item>
        <item name="colorSecondary">@color/pleos_informative_active</item>
        <item name="colorOnSecondary">@color/pleos_basic_00</item>
        <item name="android:colorBackground">@color/pleos_background_primary</item>
        <item name="android:windowBackground">@color/pleos_background_primary</item>
        <item name="android:textColorPrimary">@color/pleos_text_primary</item>
        <item name="android:textColorSecondary">@color/pleos_text_secondary</item>
        <item name="android:statusBarColor">@color/pleos_background_primary</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Pleos.Dialog</item>
    </style>

    <!-- 대화상자도 차량 화면 규격으로: 제목 Title, 목록 Body(줄 높이 100), Pleos 버튼, 모서리 48 (System popup) -->
    <style name="ThemeOverlay.Pleos.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:windowTitleStyle">@style/Pleos.DialogTitle</item>
        <item name="android:textAppearanceListItemSmall">@style/TextAppearance.Pleos.Body</item>
        <item name="textAppearanceListItemSmall">@style/TextAppearance.Pleos.Body</item>
        <item name="listPreferredItemHeightSmall">100dp</item>
        <item name="listPreferredItemPaddingLeft">48dp</item>
        <item name="listPreferredItemPaddingRight">48dp</item>
        <item name="dialogPreferredPadding">48dp</item>
        <item name="android:windowMinWidthMajor">50%</item>
        <item name="android:windowMinWidthMinor">50%</item>
        <item name="dialogCornerRadius">48dp</item>
        <item name="android:colorBackground">@color/pleos_surface_basic</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Pleos.Button.Filled</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Pleos.Button.Basic</item>
    </style>

    <style name="Pleos.DialogTitle" parent="">
        <item name="android:textAppearance">@style/TextAppearance.Pleos.TitleSmall</item>
    </style>
</resources>
