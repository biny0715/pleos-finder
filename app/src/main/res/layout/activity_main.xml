<?xml version="1.0" encoding="utf-8"?>
<!--
  차량 앱 (Connect-S-17 앱 창 1700×1184dp, 가로).
  위: 제목 + 운전자 프로필 / 그 아래: 픽업 중일 때만 보이는 픽업 줄(항상 한 칸)
  본문: 기본은 목록 한 칸, 그룹을 열면 목록 | 그룹 상세 두 칸 / 하단 가운데: Pleos 토스트
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pleos_background_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="40dp"
        android:paddingEnd="48dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_title"
                android:textAppearance="@style/TextAppearance.Pleos.Title" />

            <!-- 운전자 프로필: 눌러서 계정(운전자) 전환 -->
            <LinearLayout
                android:id="@+id/profileChip"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:background="@drawable/pleos_bg_button_basic"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="28dp"
                android:stateListAnimator="@animator/pleos_press_scale">

                <TextView
                    android:id="@+id/profileAvatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/pleos_bg_avatar"
                    android:backgroundTint="@color/pleos_button_filled_enabled"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Pleos.Label"
                    android:textColor="@color/pleos_text_on_filled"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/profileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:textAppearance="@style/TextAppearance.Pleos.Label"
                    android:textColor="@color/pleos_text_primary" />
            </LinearLayout>
        </LinearLayout>

        <!-- 픽업 줄: 픽업 중일 때만, 화면이 나뉘어도 한 칸 그대로 -->
        <LinearLayout
            android:id="@+id/pickupStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/pleos_bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="40dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/pickupProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/pleos_text_tertiary"
                app:indicatorSize="48dp"
                app:trackThickness="6dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pickupHeadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Pleos.Title" />

                <TextView
                    android:id="@+id/pickupDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Pleos.BodySmall" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pickupMetrics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="180dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/remainDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Pleos.Title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_remain_distance"
                        android:textAppearance="@style/TextAppearance.Pleos.Label" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="180dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/remainTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Pleos.Title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_remain_time"
                        android:textAppearance="@style/TextAppearance.Pleos.Label" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/pickupActionButton"
                style="@style/Widget.Pleos.Button.Basic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp" />
        </LinearLayout>

        <!-- 본문: 목록 | (그룹을 열면) 그룹 상세 -->
        <LinearLayout
            android:id="@+id/contentRow"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ScrollView
                android:id="@+id/listScroll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 지도: 내 차, 나에게 공유된 사람·차량, 픽업 중이면 내 차와 상대를 잇는 선 -->
                    <include
                        layout="@layout/finder_map_card"
                        android:layout_width="match_parent"
                        android:layout_height="360dp"
                        android:layout_marginTop="32dp" />

                    <LinearLayout
                        android:id="@+id/listContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </ScrollView>

                <!-- 그룹 상세 -->
                <LinearLayout
                    android:id="@+id/groupPanel"
                    style="@style/Widget.Pleos.Card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="32dp"
                    android:layout_weight="1"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/groupName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.Pleos.Headline" />

                        <Button
                            android:id="@+id/groupRenameButton"
                            style="@style/Widget.Pleos.Button.Basic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="16dp"
                            android:text="@string/action_rename"
                            android:visibility="gone" />

                        <Button
                            android:id="@+id/groupCloseButton"
                            style="@style/Widget.Pleos.Button.Basic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_close" />
                    </LinearLayout>

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="16dp"
                        android:layout_weight="1"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/groupMembers"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>

                    <!-- 그룹에 공유된 목적지. 구성원별 도착 예정은 위 구성원 줄에 표시한다. -->
                    <LinearLayout
                        android:id="@+id/groupDestinationBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/pleos_bg_button_basic"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="24dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/groupDestinationTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Pleos.Label" />

                            <TextView
                                android:id="@+id/groupDestinationName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:textAppearance="@style/TextAppearance.Pleos.TitleSmall" />

                            <TextView
                                android:id="@+id/groupDestinationDetail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:textAppearance="@style/TextAppearance.Pleos.BodySmall" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/groupDestinationGoButton"
                            style="@style/Widget.Pleos.Button.Filled"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp"
                            android:text="@string/action_start_navigation" />

                        <Button
                            android:id="@+id/groupDestinationClearButton"
                            style="@style/Widget.Pleos.Button.Basic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp"
                            android:text="@string/action_end_destination_share" />
                    </LinearLayout>

                    <!-- 받은 그룹 초대 -->
                    <LinearLayout
                        android:id="@+id/groupInviteBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <Button
                            android:id="@+id/groupAcceptButton"
                            style="@style/Widget.Pleos.Button.Filled"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/action_join_group" />

                        <Button
                            android:id="@+id/groupDeclineButton"
                            style="@style/Widget.Pleos.Button.Basic"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp"
                            android:layout_weight="1"
                            android:text="@string/action_decline" />
                    </LinearLayout>

                    <!-- 내 공유 설정 -->
                    <LinearLayout
                        android:id="@+id/groupShareBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/groupShareTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Pleos.Label" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <RadioGroup
                                android:id="@+id/groupShareGroup"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/pleos_segment_height"
                                android:layout_weight="1"
                                android:background="@drawable/pleos_bg_segment_container"
                                android:orientation="horizontal"
                                android:padding="@dimen/pleos_segment_inset">

                                <RadioButton
                                    android:id="@+id/groupShareAlways"
                                    style="@style/Widget.Pleos.Segment"
                                    android:text="@string/permission_always" />

                                <RadioButton
                                    android:id="@+id/groupShareTemporary"
                                    style="@style/Widget.Pleos.Segment"
                                    android:text="@string/permission_temporary" />

                                <RadioButton
                                    android:id="@+id/groupShareOff"
                                    style="@style/Widget.Pleos.Segment"
                                    android:text="@string/permission_off" />
                            </RadioGroup>

                            <Button
                                android:id="@+id/groupExtendButton"
                                style="@style/Widget.Pleos.Button.Basic"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="24dp"
                                android:text="@string/action_extend_30" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/groupShareDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textAppearance="@style/TextAppearance.Pleos.BodySmall" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:orientation="horizontal">

                            <!-- 내 목적지를 그룹에 공유해 같은 곳으로 함께 간다. -->
                            <Button
                                android:id="@+id/groupDestinationShareButton"
                                style="@style/Widget.Pleos.Button.Filled"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/action_share_destination" />

                            <Button
                                android:id="@+id/groupInviteButton"
                                style="@style/Widget.Pleos.Button.Basic"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="24dp"
                                android:layout_weight="1"
                                android:text="@string/action_invite_from_contacts" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/toast"
        style="@style/Widget.Pleos.Toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="@dimen/pleos_toast_margin"
        android:visibility="gone" />

</FrameLayout>
