<?xml version="1.0" encoding="utf-8"?>
<!--
  차량 앱 (Connect-S-17 앱 창 1700×1184dp, 가로).
  위: 제목 + 운전자 프로필 / 왼쪽: 가족·친구·그룹 패널(스크롤) / 오른쪽: 픽업 진행 또는 그룹 상세 / 하단 가운데: Pleos 토스트
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pleos_background_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="40dp"
        android:paddingEnd="48dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_title"
                android:textAppearance="@style/TextAppearance.Pleos.Title" />

            <!-- 운전자 프로필: 눌러서 계정(운전자) 전환 -->
            <LinearLayout
                android:id="@+id/profileChip"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:background="@drawable/pleos_bg_button_basic"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="28dp"
                android:stateListAnimator="@animator/pleos_press_scale">

                <TextView
                    android:id="@+id/profileAvatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/pleos_bg_avatar"
                    android:backgroundTint="@color/pleos_button_filled_enabled"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Pleos.Label"
                    android:textColor="@color/pleos_text_on_filled"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/profileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:textAppearance="@style/TextAppearance.Pleos.Label"
                    android:textColor="@color/pleos_text_primary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- 가족 · 친구 · 그룹 -->
            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="5"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/listContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="32dp"
                android:layout_marginTop="32dp"
                android:layout_weight="7">

                <!-- 픽업 -->
                <LinearLayout
                    android:id="@+id/pickupPanel"
                    style="@style/Widget.Pleos.Card"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_pickup"
                        android:textAppearance="@style/TextAppearance.Pleos.Label" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/pickupHeadline"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.Pleos.Headline" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/pickupProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorColor="@color/pleos_text_tertiary"
                            app:indicatorSize="56dp"
                            app:trackThickness="6dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/pickupDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textAppearance="@style/TextAppearance.Pleos.Body" />

                    <LinearLayout
                        android:id="@+id/pickupMetrics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="48dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/remainDistance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Pleos.Headline" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_remain_distance"
                                android:textAppearance="@style/TextAppearance.Pleos.Label" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/remainTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Pleos.Headline" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_remain_time"
                                android:textAppearance="@style/TextAppearance.Pleos.Label" />
                        </LinearLayout>
                    </LinearLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/pickupActionButton"
                        style="@style/Widget.Pleos.Button.Basic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- 그룹 상세 -->
                <LinearLayout
                    android:id="@+id/groupPanel"
                    style="@style/Widget.Pleos.Card"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/groupName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.Pleos.Headline" />

                        <Button
                            android:id="@+id/groupCloseButton"
                            style="@style/Widget.Pleos.Button.Basic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_close" />
                    </LinearLayout>

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="16dp"
                        android:layout_weight="1"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/groupMembers"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>

                    <!-- 받은 그룹 초대 -->
                    <LinearLayout
                        android:id="@+id/groupInviteBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <Button
                            android:id="@+id/groupAcceptButton"
                            style="@style/Widget.Pleos.Button.Filled"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/action_join_group" />

                        <Button
                            android:id="@+id/groupDeclineButton"
                            style="@style/Widget.Pleos.Button.Basic"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp"
                            android:layout_weight="1"
                            android:text="@string/action_decline" />
                    </LinearLayout>

                    <!-- 내 공유 설정 -->
                    <LinearLayout
                        android:id="@+id/groupShareBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/groupShareTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Pleos.Label" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <RadioGroup
                                android:id="@+id/groupShareGroup"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/pleos_segment_height"
                                android:layout_weight="1"
                                android:background="@drawable/pleos_bg_segment_container"
                                android:orientation="horizontal"
                                android:padding="@dimen/pleos_segment_inset">

                                <RadioButton
                                    android:id="@+id/groupShareAlways"
                                    style="@style/Widget.Pleos.Segment"
                                    android:text="@string/permission_always" />

                                <RadioButton
                                    android:id="@+id/groupShareTemporary"
                                    style="@style/Widget.Pleos.Segment"
                                    android:text="@string/permission_temporary" />

                                <RadioButton
                                    android:id="@+id/groupShareOff"
                                    style="@style/Widget.Pleos.Segment"
                                    android:text="@string/permission_off" />
                            </RadioGroup>

                            <Button
                                android:id="@+id/groupExtendButton"
                                style="@style/Widget.Pleos.Button.Basic"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="24dp"
                                android:text="@string/action_extend_30" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/groupShareDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textAppearance="@style/TextAppearance.Pleos.BodySmall" />

                        <Button
                            android:id="@+id/groupInviteButton"
                            style="@style/Widget.Pleos.Button.Basic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:text="@string/action_invite_from_contacts" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/toast"
        style="@style/Widget.Pleos.Toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="@dimen/pleos_toast_margin"
        android:visibility="gone" />

</FrameLayout>
